---
import timelineData from '../data/timeline.json';

interface TimelineItem {
  date: string;
  title: string;
  description?: string;
}

const items = timelineData as TimelineItem[];
const first = items[0];
---
<div class="timeline">
  <div class="tl-readout" aria-live="polite">
    <p class="tl-message"><span class="tl-msg-year">{first?.date}</span><span class="tl-msg-title">{first?.title}</span></p>
    <p class="tl-msg-desc">{first?.description}</p>
  </div>
  <div class="tl-viewport">
    <div class="tl-playhead" aria-hidden="true"></div>
    <ol class="tl-axis" tabindex="0" aria-label="Timeline — drag to scrub through the years">
      {items.map((item, i) => (
        <li
          class="tl-tick"
          data-index={i}
          data-year={item.date}
          data-title={item.title}
          data-desc={item.description ?? ''}
        >
          <span class="tl-year">{item.date}</span>
          <span class:list={['tl-line', i % 2 === 0 ? 'is-long' : 'is-short']}></span>
        </li>
      ))}
    </ol>
  </div>
</div>
<style>
  .timeline { margin-top: var(--space-2); }
  .tl-readout { min-height: 3.75rem; }
  .tl-message { margin: 0; }
  .tl-msg-year { color: var(--color-muted); font-variant-numeric: tabular-nums; margin-right: var(--space-1); }
  .tl-msg-title { font-weight: 700; }
  .tl-msg-desc { margin: 0.25rem 0 0; color: var(--color-muted); font-size: 0.9rem; }

  .tl-viewport { position: relative; margin-top: var(--space-2); }
  .tl-playhead { position: absolute; left: 50%; top: 1.35rem; bottom: 0; width: 2px; transform: translateX(-50%); background: var(--color-fg); z-index: 1; pointer-events: none; }

  .tl-axis {
    list-style: none;
    margin: 0;
    padding: 0 50%;
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    overflow-x: auto;
    position: relative;
  }
  .tl-axis:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .timeline.is-enhanced .tl-axis { scrollbar-width: none; cursor: grab; }
  .timeline.is-enhanced .tl-axis::-webkit-scrollbar { display: none; }
  .timeline.is-enhanced .tl-axis.dragging { cursor: grabbing; }

  .tl-tick { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; flex: 0 0 auto; }
  .tl-year { font-size: 0.75rem; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .tl-line { width: 2px; background: var(--color-border); }
  .tl-line.is-long { height: 2rem; }
  .tl-line.is-short { height: 1.1rem; }
  .tl-tick.is-active .tl-year { color: var(--color-fg); font-weight: 700; }
  .tl-tick.is-active .tl-line { background: var(--color-fg); width: 3px; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.timeline').forEach((tl) => {
    const axis = tl.querySelector<HTMLElement>('.tl-axis');
    const ticks = Array.from(tl.querySelectorAll<HTMLElement>('.tl-tick'));
    const msgYear = tl.querySelector<HTMLElement>('.tl-msg-year');
    const msgTitle = tl.querySelector<HTMLElement>('.tl-msg-title');
    const msgDesc = tl.querySelector<HTMLElement>('.tl-msg-desc');
    if (!axis || ticks.length === 0) return;
    tl.classList.add('is-enhanced');

    let active = -1;
    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      ticks.forEach((t, j) => t.classList.toggle('is-active', j === i));
      const t = ticks[i];
      if (msgYear) msgYear.textContent = t.dataset.year ?? '';
      if (msgTitle) msgTitle.textContent = t.dataset.title ?? '';
      if (msgDesc) msgDesc.textContent = t.dataset.desc ?? '';
    };

    const update = () => {
      const center = axis.scrollLeft + axis.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      ticks.forEach((t, i) => {
        const c = t.offsetLeft + t.offsetWidth / 2;
        const d = Math.abs(c - center);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      setActive(best);
    };

    let raf = 0;
    axis.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    });

    let isDown = false;
    let startX = 0;
    let startScroll = 0;
    axis.addEventListener('pointerdown', (e) => {
      isDown = true;
      startX = e.clientX;
      startScroll = axis.scrollLeft;
      axis.setPointerCapture(e.pointerId);
      axis.classList.add('dragging');
    });
    axis.addEventListener('pointermove', (e) => {
      if (!isDown) return;
      axis.scrollLeft = startScroll - (e.clientX - startX);
    });
    const end = () => {
      isDown = false;
      axis.classList.remove('dragging');
    };
    axis.addEventListener('pointerup', end);
    axis.addEventListener('pointercancel', end);

    window.addEventListener('resize', update);
    update();
  });
</script>
