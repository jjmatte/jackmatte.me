---
import timelineData from '../data/timeline.json';

interface TimelineItem {
  date: string;
  title: string;
  description?: string;
}

const items = timelineData as TimelineItem[];
---
<div class="timeline">
  <ol class="timeline-track" tabindex="0" aria-label="Life timeline — drag or scroll horizontally">
    {items.map((item) => (
      <li class="timeline-item">
        <span class="timeline-date">{item.date}</span>
        <h3 class="timeline-title">{item.title}</h3>
        {item.description && <p class="timeline-desc">{item.description}</p>}
      </li>
    ))}
  </ol>
  <div class="timeline-progress" aria-hidden="true"><span class="timeline-thumb"></span></div>
</div>
<style>
  .timeline { margin-top: var(--space-2); }
  .timeline-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x proximity;
  }
  .timeline-track:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .timeline.is-enhanced .timeline-track {
    scrollbar-width: none;
    cursor: grab;
  }
  .timeline.is-enhanced .timeline-track::-webkit-scrollbar { display: none; }
  .timeline.is-enhanced .timeline-track.dragging { cursor: grabbing; }
  .timeline-item {
    scroll-snap-align: start;
    flex: 0 0 12rem;
    border-left: 2px solid var(--color-border);
    padding-left: var(--space-2);
  }
  .timeline-date { color: var(--color-muted); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  .timeline-title { margin: 0.15rem 0 0.35rem; font-size: 1rem; }
  .timeline-desc { margin: 0; font-size: 0.9rem; color: var(--color-muted); }
  .timeline-progress { display: none; height: 4px; margin-top: var(--space-2); background: var(--color-border); border-radius: 2px; position: relative; }
  .timeline.is-enhanced .timeline-progress { display: block; }
  .timeline-thumb { position: absolute; top: 0; left: 0; height: 100%; width: 20%; background: var(--color-accent); border-radius: 2px; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.timeline').forEach((tl) => {
    const track = tl.querySelector<HTMLElement>('.timeline-track');
    const thumb = tl.querySelector<HTMLElement>('.timeline-thumb');
    if (!track) return;
    tl.classList.add('is-enhanced');

    const minWidth = 10;
    const updateThumb = () => {
      if (!thumb) return;
      const widthPct = Math.max((track.clientWidth / track.scrollWidth) * 100, minWidth);
      const max = track.scrollWidth - track.clientWidth;
      const posPct = max > 0 ? (track.scrollLeft / max) * (100 - widthPct) : 0;
      thumb.style.width = `${widthPct}%`;
      thumb.style.left = `${posPct}%`;
    };

    let isDown = false;
    let startX = 0;
    let startScroll = 0;
    track.addEventListener('pointerdown', (e) => {
      isDown = true;
      startX = e.clientX;
      startScroll = track.scrollLeft;
      track.setPointerCapture(e.pointerId);
      track.classList.add('dragging');
    });
    track.addEventListener('pointermove', (e) => {
      if (!isDown) return;
      track.scrollLeft = startScroll - (e.clientX - startX);
    });
    const end = () => {
      isDown = false;
      track.classList.remove('dragging');
    };
    track.addEventListener('pointerup', end);
    track.addEventListener('pointercancel', end);

    track.addEventListener('scroll', updateThumb);
    window.addEventListener('resize', updateThumb);
    updateThumb();
  });
</script>
