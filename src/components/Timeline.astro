---
import timelineData from '../data/timeline.json';

interface TimelineItem {
  date: string;
  title: string;
  description?: string;
}

const items = timelineData as TimelineItem[];
const first = items[0];
---
<div class="timeline">
  <div class="tl-readout" aria-live="polite">
    <p class="tl-message"><span class="tl-msg-year">{first?.date}</span><span class="tl-msg-title">{first?.title}</span></p>
    <p class="tl-msg-desc">{first?.description}</p>
  </div>
  <div
    class="tl-track"
    role="slider"
    tabindex="0"
    aria-label="Timeline — click a point or drag the cursor to move through the years"
    aria-valuemin="0"
    aria-valuemax={items.length - 1}
    aria-valuenow="0"
  >
    <ol class="tl-axis">
      {items.map((item, i) => (
        <li
          class="tl-tick"
          data-index={i}
          data-year={item.date}
          data-title={item.title}
          data-desc={item.description ?? ''}
        >
          <span class:list={['tl-line', i % 2 === 0 ? 'is-long' : 'is-short']}></span>
        </li>
      ))}
    </ol>
    <div class="tl-cursor" aria-hidden="true"><span class="tl-cursor-year"></span></div>
  </div>
</div>
<style>
  .timeline { margin-top: var(--space-2); display: flex; flex-direction: column; justify-content: space-between; flex: 1; gap: var(--space-3); user-select: none; -webkit-user-select: none; }
  .tl-readout { min-height: 3.75rem; }
  .tl-message { margin: 0; }
  .tl-msg-year { color: var(--color-muted); font-variant-numeric: tabular-nums; margin-right: var(--space-1); }
  .tl-msg-title { font-weight: 700; }
  .tl-msg-desc { margin: 0.25rem 0 0; color: var(--color-muted); font-size: 0.9rem; }

  .tl-track { position: relative; margin-top: auto; align-self: center; width: -moz-fit-content; width: fit-content; padding: 1.75rem var(--space-3) 0; touch-action: none; }
  .tl-track:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 4px; }
  .timeline.is-enhanced .tl-track { cursor: pointer; }
  .timeline.is-enhanced .tl-track.dragging { cursor: grabbing; }

  .tl-axis {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: flex-end;
    gap: var(--space-1);
  }

  .tl-tick { display: flex; flex-direction: column; align-items: center; flex: 0 0 auto; }
  .tl-line { width: 2px; background: var(--color-border); }
  .tl-line.is-long { height: 1.7rem; }
  .tl-line.is-short { height: 1.1rem; }
  .tl-tick.is-active .tl-line { background: var(--color-fg); width: 3px; }

  .tl-cursor { position: absolute; left: 50%; top: 1.45rem; bottom: 0; width: 2px; transform: translateX(-50%); background: #fff; pointer-events: none; z-index: 1; }
  .tl-cursor::before { content: ''; position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%); width: 10px; height: 10px; border-radius: 50%; background: var(--color-pin); }
  .tl-cursor-year { position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); margin-bottom: 0.75rem; font-size: 0.8rem; font-weight: 700; color: var(--color-fg); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .timeline.is-enhanced .tl-cursor { transition: left 0.08s ease-out; }
  .tl-track.dragging .tl-cursor { transition: none; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.timeline').forEach((tl) => {
    const track = tl.querySelector<HTMLElement>('.tl-track');
    const cursor = tl.querySelector<HTMLElement>('.tl-cursor');
    const cursorYear = tl.querySelector<HTMLElement>('.tl-cursor-year');
    const ticks = Array.from(tl.querySelectorAll<HTMLElement>('.tl-tick'));
    const msgYear = tl.querySelector<HTMLElement>('.tl-msg-year');
    const msgTitle = tl.querySelector<HTMLElement>('.tl-msg-title');
    const msgDesc = tl.querySelector<HTMLElement>('.tl-msg-desc');
    if (!track || !cursor || ticks.length === 0) return;
    tl.classList.add('is-enhanced');

    let active = -1;
    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      ticks.forEach((t, j) => t.classList.toggle('is-active', j === i));
      const t = ticks[i];
      if (msgYear) msgYear.textContent = t.dataset.year ?? '';
      if (msgTitle) msgTitle.textContent = t.dataset.title ?? '';
      if (msgDesc) msgDesc.textContent = t.dataset.desc ?? '';
      if (cursorYear) cursorYear.textContent = t.dataset.year ?? '';
      track.setAttribute('aria-valuenow', String(i));
      track.setAttribute('aria-valuetext', `${t.dataset.year ?? ''} ${t.dataset.title ?? ''}`.trim());
    };

    const tickX = (t: HTMLElement) => {
      const r = track.getBoundingClientRect();
      const tr = t.getBoundingClientRect();
      return tr.left + tr.width / 2 - r.left;
    };

    const nearest = (x: number) => {
      let best = 0;
      let bestDist = Infinity;
      ticks.forEach((t, i) => {
        const d = Math.abs(tickX(t) - x);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      return best;
    };

    const moveToX = (clientX: number) => {
      const r = track.getBoundingClientRect();
      const minX = tickX(ticks[0]);
      const maxX = tickX(ticks[ticks.length - 1]);
      const x = Math.max(minX, Math.min(maxX, clientX - r.left));
      cursor.style.left = `${x}px`;
      setActive(nearest(x));
    };

    const moveToTick = (i: number) => {
      cursor.style.left = `${tickX(ticks[i])}px`;
      setActive(i);
    };

    let dragging = false;
    track.addEventListener('pointerdown', (e) => {
      dragging = true;
      track.setPointerCapture(e.pointerId);
      track.classList.add('dragging');
      moveToX(e.clientX);
    });
    track.addEventListener('pointermove', (e) => {
      if (dragging) moveToX(e.clientX);
    });
    const end = () => {
      dragging = false;
      track.classList.remove('dragging');
    };
    track.addEventListener('pointerup', end);
    track.addEventListener('pointercancel', end);

    track.addEventListener('keydown', (e) => {
      const cur = active < 0 ? 0 : active;
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
        e.preventDefault();
        moveToTick(Math.min(ticks.length - 1, cur + 1));
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
        e.preventDefault();
        moveToTick(Math.max(0, cur - 1));
      } else if (e.key === 'Home') {
        e.preventDefault();
        moveToTick(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        moveToTick(ticks.length - 1);
      }
    });

    const reposition = () => {
      if (active >= 0) moveToTick(active);
    };
    moveToTick(0);
    requestAnimationFrame(reposition);
    window.addEventListener('load', reposition);
    if (document.fonts?.ready) document.fonts.ready.then(reposition);
    window.addEventListener('resize', reposition);
  });
</script>
