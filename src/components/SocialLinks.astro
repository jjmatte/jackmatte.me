---
const email = 'joshuajmatte@gmail.com';
const links = [
  { label: 'GitHub', href: 'https://github.com/jjmatte' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/joshua-matte-440980295/' },
];
---
<ul class="social">
  {links.map((l) => (
    <li><a href={l.href} rel="me noopener">{l.label}</a></li>
  ))}
  <li class="email">
    <a href={`mailto:${email}`} rel="me">{email}</a>
    <button type="button" class="copy-email" data-email={email} aria-label={`Copy email address ${email}`}>
      <svg class="icon icon-copy" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" />
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
      </svg>
      <svg class="icon icon-check" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12" />
      </svg>
      <span class="sr-only" aria-live="polite"></span>
    </button>
  </li>
</ul>
<style>
  .social { list-style: none; display: flex; gap: var(--space-2); padding: 0; margin: 0; flex-wrap: wrap; align-items: center; }
  .email { display: inline-flex; align-items: center; gap: var(--space-1); }
  .copy-email {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-muted);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.15rem;
    line-height: 0;
  }
  .copy-email:hover { color: var(--color-fg); }
  .copy-email[data-copied="true"] { color: var(--color-accent); border-color: var(--color-accent); }
  .icon-check { display: none; }
  .copy-email[data-copied="true"] .icon-copy { display: none; }
  .copy-email[data-copied="true"] .icon-check { display: inline; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-email').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email;
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        btn.dataset.copied = 'true';
        const status = btn.querySelector('.sr-only');
        if (status) status.textContent = 'Copied!';
        setTimeout(() => {
          delete btn.dataset.copied;
          if (status) status.textContent = '';
        }, 1500);
      } catch {
        // Clipboard unavailable (e.g. no permission); the mailto link still works.
      }
    });
  });
</script>
