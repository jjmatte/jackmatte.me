---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<section class="recent" aria-labelledby="recent-writing">
  <h2 id="recent-writing">Recent writing</h2>
  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
        <time datetime={fmt(post.data.date)}>{fmt(post.data.date)}</time>
      </li>
    ))}
  </ul>
  <p><a href="/blog">All writing &rarr;</a></p>
</section>
<style>
  .recent h2 { margin-top: 0; }
  .recent ul { list-style: none; padding: 0; margin: 0; }
  .recent li { display: flex; flex-direction: column; padding-block: var(--space-1); border-top: 1px solid var(--color-border); }
  .recent time { color: var(--color-muted); font-size: 0.85rem; }
</style>
