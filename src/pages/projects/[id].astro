---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, repo, demo, tech, screenshot, clip } = project.data;
---
<BaseLayout title={`${title} — Jack Matte`} description={description}>
  <h1>{title}</h1>
  <p>{description}</p>
  <ul class="tech">{tech.map((t) => <li>{t}</li>)}</ul>
  <p>
    {repo && <a href={repo}>Source</a>}
    {demo && <> · <a href={demo}>Live demo</a></>}
  </p>
  {clip ? (
    <video class="clip" data-project-clip loop muted playsinline preload="metadata" poster={screenshot}>
      <source src={clip} type="video/mp4" />
    </video>
  ) : screenshot ? (
    <img class="screenshot" src={screenshot} alt={`${title} screenshot`} />
  ) : null}
  <Prose><Content /></Prose>
</BaseLayout>
<script>
  // Autoplay project clips, but respect reduced-motion (they show the poster still).
  const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
  if (!reduce) {
    for (const v of document.querySelectorAll('video[data-project-clip]')) {
      (v as HTMLVideoElement).play?.().catch(() => {});
    }
  }
</script>
<style>
  .tech { list-style: none; display: flex; gap: var(--space-1); padding: 0; margin: 0 0 var(--space-2); flex-wrap: wrap; color: var(--color-muted); }
  .screenshot, .clip { max-width: 100%; height: auto; border: 1px solid var(--color-border); border-radius: 6px; margin-bottom: var(--space-2); }
  .clip { display: block; }
</style>
