---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Timeline from '../components/Timeline.astro';
import RecentWriting from '../components/RecentWriting.astro';
import { getFeatured } from '../lib/projects';

const featured = getFeatured(await getCollection('projects'));
---
<BaseLayout title="Jack Matte">
  <h1>Hello, my name is Jack.</h1>
  <p class="lede">Software engineer. I build clean, practical web software.</p>
  <SocialLinks />

  <section class="about-row" aria-label="About">
    <div class="about-col">
      <h2 class="col-title">About Me</h2>
      <hr class="col-rule" />
      <div class="about-card">
        <Timeline />
      </div>
    </div>
    <RecentWriting />
  </section>

  <section aria-labelledby="featured">
    <h2 id="featured">Featured projects</h2>
    {featured.map((project) => <ProjectCard project={project} />)}
    <p><a href="/projects">All projects &rarr;</a></p>
  </section>
</BaseLayout>
<style>
  h1 { color: var(--color-pin); font-size: 2.9rem; line-height: 1.12; }
  .lede { font-size: 1.5rem; color: var(--color-muted); }
  section { margin-top: var(--space-4); }
  .about-row { display: grid; grid-template-columns: 590px 1fr; gap: var(--space-4); align-items: start; }
  .about-col { min-width: 0; }
  .col-title { margin-top: 0; }
  .col-rule { border: none; border-top: 1px solid var(--color-border); margin: 0 0 var(--space-3) 0; }
  .about-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; padding: var(--space-3); min-width: 0; min-height: 281px; display: flex; flex-direction: column; font-size: 1.0625rem; --space-1: 0.5rem; --space-2: 1rem; --space-3: 1.5rem; }
  @media (max-width: 900px) {
    .about-row { grid-template-columns: 1fr; }
  }
</style>
